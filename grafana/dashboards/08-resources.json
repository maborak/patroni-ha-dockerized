{
 "uid": "host-resources",
 "title": "08 \u00b7 Host Resources",
 "description": "The laptop itself: CPU, memory, disk and network behind the database.",
 "tags": [
  "host",
  "patroni-ha"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1105,
   "title": "CPU busy %",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))",
     "legendFormat": "busy",
     "refId": "A"
    },
    {
     "expr": "avg(rate(node_cpu_seconds_total{mode=\"iowait\"}[$__rate_interval])) * 100",
     "legendFormat": "iowait",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 1106,
   "title": "Memory",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 8,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
     "legendFormat": "used",
     "refId": "A"
    },
    {
     "expr": "node_memory_MemAvailable_bytes",
     "legendFormat": "available",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 1107,
   "title": "Filesystem free bytes",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 16,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "node_filesystem_avail_bytes{fstype=~\"xfs|ext4\"}",
     "legendFormat": "{{device}} {{mountpoint}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 1108,
   "title": "Disk I/O utilization",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 0,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "rate(node_disk_io_time_seconds_total{device!~\"loop.*|ram.*\"}[$__rate_interval])",
     "legendFormat": "io time/s {{device}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 1109,
   "title": "Disk throughput",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 8,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "sum by (device)(rate(node_disk_read_bytes_total{device!~\"loop.*|ram.*\"}[$__rate_interval]))",
     "legendFormat": "read",
     "refId": "A"
    },
    {
     "expr": "sum by (device)(rate(node_disk_written_bytes_total{device!~\"loop.*|ram.*\"}[$__rate_interval]))",
     "legendFormat": "written",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 1110,
   "title": "Network throughput",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 16,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "sum by (device)(rate(node_network_receive_bytes_total{device!=\"lo\"}[$__rate_interval]))",
     "legendFormat": "rx",
     "refId": "A"
    },
    {
     "expr": "sum by (device)(rate(node_network_transmit_bytes_total{device!=\"lo\"}[$__rate_interval]))",
     "legendFormat": "tx",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  }
 ]
}