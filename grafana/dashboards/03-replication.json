{
 "uid": "patroni-replication",
 "title": "03 \u00b7 Replication & Slots",
 "description": "Streaming lag, WAL sender health and replication-slot retention.",
 "tags": [
  "replication",
  "patroni-ha"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1028,
   "title": "Replication lag (bytes)",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "max(patroni_xlog_location) - on(instance) (patroni_xlog_replayed_location + 0 * patroni_xlog_location)",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 1029,
   "title": "Replay delay (seconds)",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "pg_replication_replay_lag_seconds > 0",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 1030,
   "title": "Slots active / total",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 18,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "count(pg_replication_slot_slot_is_active == 1) or vector(0)",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "short"
     },
     "overrides": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "auto"
   }
  },
  {
   "id": 1031,
   "title": "Slot retaining >2GB WAL",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 21,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "count(pg_replication_slots_pg_wal_lsn_diff > 2147483648) or vector(0)",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "short"
     },
     "overrides": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "g",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "auto"
   }
  },
  {
   "id": 1032,
   "title": "Slot retained WAL",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "pg_replication_slots_pg_wal_lsn_diff",
     "legendFormat": "{{slot}} @ {{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 1033,
   "title": "Sender reply age",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "time() - pg_stat_replication_reply_time",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 1034,
   "title": "WAL senders configured",
   "type": "stat",
   "gridPos": {
    "h": 3,
    "w": 3,
    "x": 18,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "max(pg_settings_max_wal_senders)",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "short"
     },
     "overrides": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "auto"
   }
  },
  {
   "id": 1035,
   "title": "Sync replicas",
   "type": "stat",
   "gridPos": {
    "h": 3,
    "w": 3,
    "x": 21,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "count(patroni_sync_standby == 1) or vector(0)",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "short"
     },
     "overrides": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "auto"
   }
  },
  {
   "id": 1036,
   "title": "Slot inventory",
   "type": "table",
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 0,
    "y": 14
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "pg_replication_slot_slot_is_active",
     "instant": true,
     "format": "table",
     "refId": "A"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true
      }
     }
    },
    {
     "id": "sorting",
     "options": {
      "sort": [
       {
        "field": "Value #A",
        "desc": true
       }
      ]
     }
    }
   ],
   "options": {
    "showHeader": true
   }
  }
 ]
}