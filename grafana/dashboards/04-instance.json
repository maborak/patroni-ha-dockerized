{
 "uid": "patroni-instance",
 "title": "04 \u00b7 PostgreSQL Instance",
 "description": "Per-node drill-down. Pick a node with the Node selector.",
 "tags": [
  "postgres",
  "patroni-ha"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1037,
   "title": "Uptime",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "pg_activity_process_uptime_seconds{instance=~\"$node\"}",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "s"
     },
     "overrides": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "auto"
   }
  },
  {
   "id": 1038,
   "title": "Version major",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "patroni_postgres_server_version{instance=~\"$node\"} / 10000",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "short"
     },
     "overrides": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "auto"
   }
  },
  {
   "id": 1039,
   "title": "Connections used %",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "pg_activity_connections{instance=~\"$node\"} / pg_activity_max_connections{instance=~\"$node\"}",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "percentunit"
     },
     "overrides": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "g",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.7
       },
       {
        "color": "red",
        "value": 0.85
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "auto"
   }
  },
  {
