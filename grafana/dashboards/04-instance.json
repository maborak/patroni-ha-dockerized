  {
   "id": 1041,
   "title": "Cache hit % ($db)",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "rate(pg_stat_database_blks_hit{datname=\"$db\", instance=~\"$node\"}[$__rate_interval]) / clamp_min(rate(pg_stat_database_blks_hit{datname=\"$db\", instance=~\"$node\"}[$__rate_interval]) + rate(pg_stat_database_blks_read{datname=\"$db\", instance=~\"$node\"}[$__rate_interval]), 0.001)",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "percentunit"
     },
     "overrides": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "r",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.9
       },
       {
        "color": "green",
        "value": 0.97
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "auto"
   }
  },
