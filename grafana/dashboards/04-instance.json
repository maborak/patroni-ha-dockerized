   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "rate(pg_stat_database_temp_files{datname=\"$db\", instance=~\"$node\"}[$__rate_interval])",
     "legendFormat": "files/s",
     "refId": "A"
    },
    {
     "expr": "rate(pg_stat_database_temp_bytes{datname=\"$db\", instance=~\"$node\"}[$__rate_interval])",
     "legendFormat": "bytes/s",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
