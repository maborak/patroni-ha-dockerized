   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"$db\", instance=~\"$node\"}[$__rate_interval]))",
     "legendFormat": "hit",
