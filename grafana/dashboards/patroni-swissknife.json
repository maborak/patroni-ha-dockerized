{
 "uid": "patroni-swissknife",
 "title": "PostgreSQL HA \u2014 Swiss Knife Pro",
 "description": "Full-granularity: Patroni topology, replication, WAL/archiving, throughput, sessions & locks, pg_stat_statements, vacuum hotspots, host resources.",
 "tags": [
  "patroni",
  "postgresql",
  "ha"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "db",
    "label": "Database",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "query": "label_values(pg_database_size_bytes, datname)",
    "refresh": 1,
    "includeAll": false,
    "current": {
     "text": "maborak",
     "value": "maborak"
    }
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "type": "dashboard",
    "enable": true
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "title": "Nodes up",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "count(up{job=\"patroni\"} == 1)",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "short"
     },
     "overrides": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "green",
        "value": 3
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 2,
   "title": "Leader present",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "count(patroni_primary == 1) or vector(0)",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "short"
     },
     "overrides": [],
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "YES",
         "color": "green"
        },
        "0": {
         "text": "NO LEADER",
         "color": "red"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 3,
   "title": "WAL archive staleness (s)",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "max(pg_archiver_since_last_archived_seconds)",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "s"
     },
     "overrides": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "yellow",
        "value": 300
       },
       {
        "color": "red",
        "value": 600
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 4,
   "title": "Oldest transaction (s)",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "max(pg_transactions_longest_tx_seconds)",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "s"
     },
     "overrides": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "orange",
        "value": 300
       },
       {
        "color": "red",
        "value": 900
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 5,
   "title": "Idle-in-tx sessions",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "max(pg_transactions_idle_in_tx_count)",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "short"
     },
     "overrides": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "orange",
        "value": 3
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 6,
   "title": "Host disk free %",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "min(node_filesystem_avail_bytes{mountpoint=\"/host\"}) / min(node_filesystem_size_bytes{mountpoint=\"/host\"})",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "percentunit"
     },
     "overrides": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.15
       },
       {
        "color": "green",
        "value": 0.25
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 7,
   "title": "Cluster topology",
   "type": "table",
   "gridPos": {
    "h": 9,
    "w": 8,
    "x": 0,
    "y": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "patroni_postgres_running * on(instance) group_left patroni_primary",
     "instant": true,
     "format": "table",
     "refId": "A"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true
      }
     }
    },
    {
     "id": "sorting",
     "options": {
      "sort": [
       {
        "field": "Value #A",
        "desc": true
       }
      ]
     }
    }
   ],
   "options": {
    "showHeader": true
   }
  },
  {
   "id": 8,
   "title": "Replication lag (bytes)",
   "type": "timeseries",
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 8,
    "y": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "max(patroni_xlog_location) - on(instance) (patroni_xlog_replayed_location + 0 * patroni_xlog_location)",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 9,
   "title": "Replay delay (seconds)",
   "type": "timeseries",
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 16,
    "y": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "pg_replication_replay_lag_seconds > 0",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 10,
   "title": "Timeline per node",
   "type": "timeseries",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "max by (instance)(patroni_timeline)",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 11,
   "title": "DCS last seen (s ago)",
   "type": "timeseries",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "time() - patroni_dcs_last_seen",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 12,
   "title": "Replication slots \u2014 retained WAL",
   "type": "timeseries",
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 16,
    "y": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "pg_replication_slots_pg_wal_lsn_diff",
     "legendFormat": "{{slot}} @ {{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 13,
   "title": "WAL directory size",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 0,
    "y": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "pg_wal_size_bytes",
     "legendFormat": "size {{instance}}",
     "refId": "A"
    },
    {
     "expr": "pg_wal_segments * 16777216",
     "legendFormat": "segments\u00d716MB {{instance}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 14,
   "title": "WAL archive rate",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 6,
    "y": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "sum by (instance)(rate(pg_stat_archiver_archived_count[5m]))",
     "legendFormat": "archived {{instance}}",
     "refId": "A"
    },
    {
     "expr": "sum by (instance)(rate(pg_stat_archiver_failed_count[5m]))",
     "legendFormat": "FAILED {{instance}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 15,
   "title": "Archive failures (1h)",
   "type": "stat",
   "gridPos": {
    "h": 6,
    "w": 3,
    "x": 12,
    "y": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "sum(increase(pg_stat_archiver_failed_count[1h]))",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "short"
     },
     "overrides": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "id": 16,
   "title": "Checkpoint pressure (requested ratio)",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 3,
    "x": 15,
    "y": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "rate(pg_checkpoints_requested[5m]) / clamp_min(rate(pg_checkpoints_timed[5m]) + rate(pg_checkpoints_requested[5m]), 0.001)",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 17,
   "title": "WAL generation rate (bytes/s)",
   "type": "timeseries",
   "gridPos": {
    "h": 4,
    "w": 12,
    "x": 0,
    "y": 19
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "deriv(patroni_xlog_location[2m])",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 18,
   "title": "Max WAL size vs pg_wal dir",
   "type": "timeseries",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 19
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "pg_settings_max_wal_size_bytes",
     "legendFormat": "max_wal_size {{instance}}",
     "refId": "A"
    },
    {
     "expr": "pg_wal_size_bytes",
     "legendFormat": "pg_wal dir {{instance}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 19,
   "title": "Transactions per second ($db)",
   "type": "timeseries",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 23
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "sum by (instance) (rate(pg_stat_database_xact_commit{datname=\"$db\"}[$__rate_interval]))",
     "legendFormat": "commit {{instance}}",
     "refId": "A"
    },
    {
     "expr": "sum by (instance) (rate(pg_stat_database_xact_rollback{datname=\"$db\"}[$__rate_interval]))",
     "legendFormat": "rollback {{instance}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 20,
   "title": "Tuple traffic ($db)",
   "type": "timeseries",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 23
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "sum by (instance)(rate(pg_stat_database_tup_inserted{datname=\"$db\"}[$__rate_interval]))",
     "legendFormat": "insert",
     "refId": "A"
    },
    {
     "expr": "sum by (instance)(rate(pg_stat_database_tup_updated{datname=\"$db\"}[$__rate_interval]))",
     "legendFormat": "update",
     "refId": "B"
    },
    {
     "expr": "sum by (instance)(rate(pg_stat_database_tup_deleted{datname=\"$db\"}[$__rate_interval]))",
     "legendFormat": "delete",
     "refId": "C"
    },
    {
     "expr": "sum by (instance)(rate(pg_stat_database_tup_returned{datname=\"$db\"}[$__rate_interval]))",
     "legendFormat": "returned",
     "refId": "D"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 21,
   "title": "Cache hit ratio ($db)",
   "type": "timeseries",
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 23
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "sum by (instance) (rate(pg_stat_database_blks_hit{datname=\"$db\"}[$__rate_interval]) / clamp_min(rate(pg_stat_database_blks_hit{datname=\"$db\"}[$__rate_interval]) + rate(pg_stat_database_blks_read{datname=\"$db\"}[$__rate_interval]), 0.001)) > 0",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 22,
   "title": "Connections",
   "type": "timeseries",
