{
 "uid": "patroni-wal-backup",
 "title": "07 \u00b7 WAL, Archiving & Backups",
 "description": "Write-ahead log pressure, archive pipeline and slot retention.",
 "tags": [
  "wal",
  "patroni-ha"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1067,
   "title": "WAL directory size",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "pg_wal_size_bytes",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 1068,
   "title": "WAL segments",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "pg_wal_segments",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 1069,
   "title": "Archive rate",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "sum by (instance)(rate(pg_stat_archiver_archived_count[5m]))",
     "legendFormat": "archived {{instance}}",
     "refId": "A"
    },
    {
     "expr": "sum by (instance)(rate(pg_stat_archiver_failed_count[5m]))",
     "legendFormat": "FAILED {{instance}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 1070,
   "title": "Staleness (s)",
   "type": "stat",
   "gridPos": {
    "h": 3,
    "w": 3,
    "x": 18,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "max(pg_archiver_since_last_archived_seconds)",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "s"
     },
     "overrides": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "g",
        "value": null
       },
       {
        "color": "yellow",
        "value": 300
       },
       {
        "color": "red",
        "value": 600
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "auto"
   }
  },
  {
   "id": 1071,
   "title": "Failures (1h)",
   "type": "stat",
   "gridPos": {
    "h": 3,
    "w": 3,
    "x": 21,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "sum(increase(pg_stat_archiver_failed_count[1h]))",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "short"
     },
     "overrides": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "g",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "auto"
   }
  },
  {
   "id": 1072,
   "title": "WAL generation rate",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 0,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "deriv(patroni_xlog_location[2m])",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 1073,
   "title": "Segments in use",
   "type": "stat",
   "gridPos": {
    "h": 3,
    "w": 3,
    "x": 12,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "max(pg_wal_segments)",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "short"
     },
     "overrides": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "auto"
   }
  },
  {
   "id": 1074,
   "title": "wal_segment_size",
   "type": "stat",
   "gridPos": {
    "h": 3,
    "w": 3,
    "x": 15,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "max(pg_settings_wal_segment_size_bytes)",
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "defaults": {
      "unit": "bytes"
     },
     "overrides": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "textMode": "auto"
   }
  },
  {
   "id": 1075,
   "title": "Slot retained WAL",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 18,
    "y": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "pg_replication_slots_pg_wal_lsn_diff",
     "legendFormat": "{{slot}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 1076,
   "title": "Checkpoint timing pressure",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 0,
    "y": 12
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "rate(pg_checkpoints_requested[5m]) / clamp_min(rate(pg_checkpoints_timed[5m]) + rate(pg_checkpoints_requested[5m]), 0.001)",
     "legendFormat": "requested {{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 1077,
   "title": "max_wal_size headroom",
   "type": "timeseries",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 12,
    "y": 12
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "pg_wal_size_bytes / pg_settings_max_wal_size_bytes",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  }
 ]
}